DATABASE_API_KEY=PASTE_DATABASE_KEY_HERE
DATABASE_API_URL=
DATABASE_STORAGE_FILE=/tmp/jokes-database.json
DATABASE_CACHE_TTL_MS=30000
DATABASE_QUERY_LIMIT=20
DATABASE_MAX_QUERY_LIMIT=100
AUTH_STORAGE_FILE=/tmp/jokes-auth.json
AUTH_SESSION_TTL_MS=315360000000
AUTH_PASSWORD_MIN_LENGTH=8
AUTH_MAX_SESSIONS_PER_USER=0
AUTH_SESSION_COOKIE_NAME=joke_auth_session
AUTH_SECURE_COOKIES=true
